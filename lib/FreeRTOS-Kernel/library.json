{
  "name": "FreeRTOS-Kernel",
  "version": "11.3.1",
  "description": "Official FreeRTOS kernel (github.com/FreeRTOS/FreeRTOS-Kernel, tag V11.3.1). Build manifest added locally for the SAMD21 (ARMv6-M) port.",
  "license": "MIT",
  "build": {
    "srcDir": ".",
    "includeDir": "include",
    "libArchive": false,
    "srcFilter": [
      "-<*>",
      "+<tasks.c>",
      "+<list.c>",
      "+<queue.c>",
      "+<timers.c>",
      "+<event_groups.c>",
      "+<stream_buffer.c>",
      "+<portable/GCC/ARM_CM0/port.c>",
      "+<portable/GCC/ARM_CM0/portasm.c>",
      "+<portable/MemMang/heap_4.c>"
    ]
  }
}
